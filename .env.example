# Copy to .env and fill in. Never commit .env.

# Which model reads the chat: gemini (Google API) or ollama (local, nothing leaves your computer)
GCL_LLM_PROVIDER=gemini
GCL_OLLAMA_MODEL=qwen3:8b
# Ollama context window (tokens). Bigger = more of the chat per question, but slower and more RAM
GCL_OLLAMA_NUM_CTX=16384

# Gemini API key: only needed when GCL_LLM_PROVIDER=gemini
GCL_GEMINI_API_KEY=bla-bla
GCL_GEMINI_MODEL=gemini-3.8-flash
# Sent to Google as the request deadline; must cover the model's thinking time
GCL_LLM_TIMEOUT_SECONDS=120
GCL_LLM_MAX_ATTEMPTS=3
# MINIMAL / LOW / MEDIUM / HIGH. Leave empty if your model rejects it (400 INVALID_ARGUMENT)
GCL_GEMINI_THINKING_LEVEL=LOW

# SQLite database location
GCL_DB_PATH=data/gcl.db

# Timezone used to resolve "tomorrow", "Sunday" etc.
GCL_DEFAULT_TIMEZONE=Asia/Kolkata

# Reject chat exports larger than this (MB)
GCL_MAX_IMPORT_MB=10

GCL_LOG_LEVEL=INFO